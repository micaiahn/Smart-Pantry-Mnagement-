<?xml version="1.0" encoding="utf-8"?>
<!-- Smart Pantry Manager - layout by Micaiah Nhamburo -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_peach">

            <ImageView
                android:id="@+id/iv_stat_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/pantry_brown" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_stat_label"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_stat_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pantry_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
